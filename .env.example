# Hybrid RA SaaS — Cloud Control Plane Configuration
# Copy to cloud-control-plane/.env and fill in your values.

# ----- Database -----
DATABASE_URL=postgresql://ra_user:change-me@localhost:5432/ra_ccp_db

# ----- Blob Storage (Azure Blob) -----
BLOB_ACCOUNT_NAME=your-storage-account
BLOB_CONTAINER_NAME=ra-documents
BLOB_ACCOUNT_KEY=change-me

# ----- Application Insights -----
APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=change-me

# ----- CORS (GAP-01) -----
# Comma-separated list of allowed origins
CORS_ORIGINS=https://regula.abyz-lab.work

# ----- Regula Knowledge Push (GAP-03) -----
# Endpoint on ra-med-bot that receives crawled documents for Vectorize upsert
REGULA_KNOWLEDGE_PUSH_URL=https://regula.abyz-lab.work/api/admin/radar/sync
# Shared secret; must match CRAWL_PUSH_SECRET on the ra-med-bot side
# Generate with: openssl rand -hex 32
CRAWL_PUSH_SECRET=change-me-strong-secret
