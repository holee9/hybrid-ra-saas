# Hybrid RA — Customer Runtime Configuration
# Copy to .env and fill in your values, or run ./setup.sh for guided setup.

# ----- Organization -----
ORG=your-org-name

# ----- Database -----
DB_USER=ra_user
DB_PASSWORD=change-me-strong-password
DB_NAME=ra_db

# ----- Storage (MinIO) -----
MINIO_USER=minioadmin
MINIO_PASSWORD=change-me-strong-password
MINIO_BUCKET=ra-documents

# ----- LLM (Ollama) -----
OLLAMA_MODEL=llama3.1:8b

# ----- API Security -----
# Minimum 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-must-be-at-least-32-characters-long!!
JWT_TTL_MIN=60

# ----- Cloud Sync -----
# Point to your Hybrid RA cloud API endpoint
CLOUD_SYNC_ENDPOINT=https://api-prod.victoriousforest-c9f2300f.koreacentral.azurecontainerapps.io

# ----- API Settings -----
RATE_LIMIT_PER_MIN=100
CORS_ORIGINS=http://localhost:8080

# ----- Regula SaaS Integration (GAP-02, GAP-06) -----
# API key for server-to-server calls from ra-med-bot (X-Regula-API-Key header)
# Generate with: openssl rand -hex 32
REGULA_API_KEY=
# Webhook URL to push audit events to Regula (ra-med-bot endpoint, GAP-06)
# Leave empty to disable outbound audit push
REGULA_AUDIT_WEBHOOK_URL=
# Webhook URL to push IFU parse results to Regula on completion (GAP-07)
# Leave empty to disable outbound IFU push
REGULA_IFU_WEBHOOK_URL=
